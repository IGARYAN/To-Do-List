{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todo-list",
  "version": "0.1.0",
  "identifier": "com.todo-list.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "To-Do List",
        "label": "main",
        "width": 800,
        "height": 600,
        "minWidth": 500,
        "minHeight": 500,
        "resizable": true,
        "maximizable": true,
        "center": true,
        "alwaysOnTop": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
