{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "opener:default",
    "core:path:default",
    "core:path:allow-resolve",
    "core:path:allow-resolve-directory",
    "core:path:allow-dirname",
    "core:path:allow-is-absolute",
    "core:path:allow-normalize",
    "core:path:allow-join",
    "core:path:allow-basename",
    "core:path:allow-extname",
    "core:event:default",
    "core:default",
    "fs:default",
    "fs:allow-stat",
    "fs:allow-write",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-create",
    "fs:allow-read",
    "fs:allow-exists",
    "fs:allow-resource-read-recursive",
    "fs:allow-resource-read",
    "fs:allow-resource-write-recursive",
    "fs:allow-resource-write",
    "core:image:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:webview:default",
    "core:webview:allow-webview-show",
    "core:webview:allow-webview-hide",
    "core:webview:allow-create-webview",
    "core:webview:allow-set-webview-focus",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-center",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-destroy",
    "core:window:allow-set-position",
    "core:window:allow-set-closable",
    "core:window:allow-set-size-constraints",
    "core:window:allow-is-maximized",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-is-always-on-top",
    "core:window:allow-set-always-on-top",
    "core:window:allow-inner-position",
    "core:window:allow-inner-size",
    "core:window:allow-available-monitors",
    "core:window:allow-current-monitor",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-maximizable",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-primary-monitor",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-maximizable",
    "core:window:allow-set-resizable",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-focus",
    "core:window:allow-is-focused",
    "core:window:allow-set-title",
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}